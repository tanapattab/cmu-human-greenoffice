# Block direct web access to .env (API key) and other dotfiles.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Don't expose file listings for asset folders that have no index file
# (images/, css/, js/, webfonts/).
Options -Indexes

# Security headers.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Only takes effect when served over HTTPS (production); harmless no-op over plain HTTP (local dev).
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # 'unsafe-inline' is required for script-src/style-src because the theme relies on inline
    # <script>/<style> blocks throughout - this still blocks injected *external* script/frame
    # sources, which is the more common XSS delivery method.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.google.com; base-uri 'self'; object-src 'none'; form-action 'self'"
</IfModule>

# Force UTF-8 for this site regardless of the server's global php.ini /
# Apache defaults. Fixes Thai text showing as mojibake (à¸„à¸“à¸° ...).
AddDefaultCharset UTF-8

<IfModule mod_php7.c>
    php_value default_charset "UTF-8"
    php_flag mbstring.encoding_translation off
</IfModule>
<IfModule mod_php.c>
    php_value default_charset "UTF-8"
    php_flag mbstring.encoding_translation off
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^about/?$ about.php [L,QSA]
    RewriteRule ^activities/?$ activities.php [L,QSA]
    RewriteRule ^resources/?$ resources.php [L,QSA]
    RewriteRule ^documents/?$ documents.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^news/?$ news.php [L,QSA]
    RewriteRule ^news/([0-9]+)/?$ news-detail.php?id=$1 [L,QSA]
    RewriteRule ^criteria/?$ criteria-detail.php [L,QSA]
    RewriteRule ^criteria/([0-9]+)/?$ criteria-detail.php?cat=$1 [L,QSA]
</IfModule>
